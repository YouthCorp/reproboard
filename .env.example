# D2: local Supabase API URL from the running local stack (public).
NEXT_PUBLIC_SUPABASE_URL=
# D2: local publishable key, or legacy anon key (public; never service_role/secret).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# D3: OAuth application return origin, normally http://127.0.0.1:3000 (public).
NEXT_PUBLIC_SITE_URL=
# Local synthetic login only when NODE_ENV=development and the API is loopback.
# Never use a NEXT_PUBLIC_ prefix for this switch or for credentials.
DEV_LOGIN_ENABLED=
