{
  "name": "reproboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "node scripts/local-db.mjs migrate",
    "db:types": "node scripts/local-db.mjs types",
    "db:env": "node scripts/local-db.mjs env",
    "db:reset": "node scripts/local-db.mjs reset",
    "db:seed": "node scripts/seed-local.mjs",
    "test:db": "node --test --test-concurrency=1 tests/db/*.test.mjs",
    "test:local-tools": "node --test tests/local-tools/*.test.mjs",
    "test:db-ui": "playwright test --config playwright.db.config.mjs",
    "test:ux": "playwright test --config playwright.ux.config.mjs",
    "test:integration:db": "node scripts/test-integration.mjs db",
    "test:integration:ui": "node scripts/test-integration.mjs ui"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
